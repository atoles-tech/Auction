<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="user-changelog-1" author="atoles">
        <createTable tableName="users">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="credentail_id" type="BIGINT">
                <constraints nullable="false" 
                             foreignKeyName="fk_users_credential"
                             references="credentials(id)"/>
            </column>

            <column name="firstname" type="VARCHAR(50)">
            </column>

            <column name="lastname" type="VARCHAR(50)">
            </column>
        
        </createTable>

    </changeSet>

    <changeSet id="user-changelog-2" author="atoles">
        <renameColumn tableName="users" oldColumnName="credentail_id" newColumnName="credential_id" />

    </changeSet>

</databaseChangeLog>